# Static site for ftc-embeds.com, served inside the ftc-embeds-web container on :80. TLS and the
# public hostname are handled by the server's edge Caddy (see deploy/edge.Caddyfile).
:80 {
	root * /srv
	encode zstd gzip

	# Team pages: /teams/16382 is teams.html for every team. The template puts the number (digits
	# only, from the regexp) in its title and links before the page is sent.
	@team path_regexp team ^/teams/(\d{1,6})/?$
	rewrite @team /teams.html
	templates /teams.html

	# Clean URLs: /embed/pit-map -> embed/pit-map.html
	try_files {path} {path}.html {path}/index.html
	file_server

	# Library and example data are loaded by other websites.
	@shared path /lib/* /examples/*
	header @shared {
		Access-Control-Allow-Origin "*"
		Cache-Control "public, max-age=3600"
	}
	header /embed/* Cache-Control "public, max-age=300"
	# The site's own fonts (fonts/fonts.css itself gets a ?v= content hash from the build).
	header /fonts/* Cache-Control "public, max-age=604800"
	header {
		Referrer-Policy "strict-origin-when-cross-origin"
		X-Content-Type-Options "nosniff"
		-Server
	}

	# Extra server-local config, if any
	import extra/*.caddy
}
