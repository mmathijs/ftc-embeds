# Static site for ftc-embeds.com, served inside the ftc-embeds-web container on :80. TLS and the
# public hostname are handled by the server's edge Caddy (see deploy/edge.Caddyfile).
:80 {
	root * /srv
	encode zstd gzip

	# Team pages: /teams/16382 is teams.html for every team. The template puts the number (digits
	# only, from the regexp) in its title and links before the page is sent.
	@team path_regexp team ^/teams/(\d{1,6})/?$
	rewrite @team /teams.html
	templates /teams.html
	# The team data the template reads (scripts/sitemap.mjs) is for the template only.
	respond /_data/* 404

	# oEmbed, so pasting a widget's link in WordPress (and other sites that ask) embeds it:
	# /oembed?url=https://ftc-embeds.com/embed/team-card?team=19444 is _oembed.json, which the
	# template turns into the answer (an iframe of that page). The embed and team pages link to it.
	rewrite /oembed /_oembed.json?{query}
	templates /_oembed.json {
		mime application/json
	}
	# (header runs before rewrite: it matches the public path)
	header /oembed {
		Content-Type "application/json; charset=utf-8"
		Access-Control-Allow-Origin "*"
		Cache-Control "public, max-age=86400"
	}
	# The embed pages' <link rel="alternate" type="application/json+oembed"> names their own URL.
	templates /embed/*

	# Clean URLs: /embed/pit-map -> embed/pit-map.html
	try_files {path} {path}.html {path}/index.html
	file_server

	# Library and example data are loaded by other websites.
	@shared path /lib/* /examples/*
	header @shared {
		Access-Control-Allow-Origin "*"
		Cache-Control "public, max-age=3600"
	}
	header /embed/* Cache-Control "public, max-age=300"
	# The site's own fonts (fonts/fonts.css itself gets a ?v= content hash from the build).
	header /fonts/* Cache-Control "public, max-age=604800"
	header {
		Referrer-Policy "strict-origin-when-cross-origin"
		X-Content-Type-Options "nosniff"
		-Server
	}

	# Extra server-local config, if any
	import extra/*.caddy
}
