# Embed statistics: logs only embed and library loads, with the site that
# embeds them (Referer) but without IP addresses or other headers. See scripts/stats.sh.
log embeds {
	output file /logs/embeds.log {
		roll_size 10MiB
		roll_keep 5
		mode 0644
	}
	format filter {
		wrap json
		fields {
			request>remote_ip delete
			request>remote_port delete
			request>client_ip delete
			request>headers delete
			request>tls delete
			resp_headers delete
			user_id delete
		}
	}
}
@untracked not path /embed/* /lib/*
log_skip @untracked
log_append referer {http.request.header.Referer}

# Public statistics page: /stats and the /stats.json it loads (regenerated by cron every
# 10 minutes).
@stats path /stats /stats/ /stats.html /stats.json
handle @stats {
	root * /etc/caddy/extra/www
	rewrite /stats /stats.html
	rewrite /stats/ /stats.html
	header Cache-Control "public, max-age=60"
	file_server
}
