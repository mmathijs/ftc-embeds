{
    "name": "ftc-embeds",
    "version": "0.28.0",
    "description": "Embeddable FIRST Tech Challenge widgets (pit maps, team cards, season results, awards, next match, season + live, event rankings, match schedules, advancement, league standings, countdowns). Zero dependencies; works with any framework.",
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/mmathijs/ftc-embeds.git"
    },
    "homepage": "https://ftc-embeds.com/",
    "bugs": {
        "url": "https://github.com/mmathijs/ftc-embeds/issues"
    },
    "exports": {
        "./pit-map": {
            "types": "./src/pit-map/pit-map.d.ts",
            "import": "./src/pit-map/pit-map.mjs",
            "require": "./dist/pit-map.umd.js"
        },
        "./pit-map/umd": "./dist/pit-map.umd.min.js",
        "./team-card": {
            "types": "./src/team-card/team-card.d.ts",
            "import": "./src/team-card/team-card.mjs",
            "require": "./dist/team-card.umd.js"
        },
        "./team-card/umd": "./dist/team-card.umd.min.js",
        "./team-results": {
            "types": "./src/team-results/team-results.d.ts",
            "import": "./src/team-results/team-results.mjs",
            "require": "./dist/team-results.umd.js"
        },
        "./team-results/umd": "./dist/team-results.umd.min.js",
        "./team-awards": {
            "types": "./src/team-awards/team-awards.d.ts",
            "import": "./src/team-awards/team-awards.mjs",
            "require": "./dist/team-awards.umd.js"
        },
        "./team-awards/umd": "./dist/team-awards.umd.min.js",
        "./next-match": {
            "types": "./src/next-match/next-match.d.ts",
            "import": "./src/next-match/next-match.mjs",
            "require": "./dist/next-match.umd.js"
        },
        "./next-match/umd": "./dist/next-match.umd.min.js",
        "./team-season": {
            "types": "./src/team-season/team-season.d.ts",
            "import": "./src/team-season/team-season.mjs",
            "require": "./dist/team-season.umd.js"
        },
        "./team-season/umd": "./dist/team-season.umd.min.js",
        "./event-rankings": {
            "types": "./src/event-rankings/event-rankings.d.ts",
            "import": "./src/event-rankings/event-rankings.mjs",
            "require": "./dist/event-rankings.umd.js"
        },
        "./event-rankings/umd": "./dist/event-rankings.umd.min.js",
        "./event-matches": {
            "types": "./src/event-matches/event-matches.d.ts",
            "import": "./src/event-matches/event-matches.mjs",
            "require": "./dist/event-matches.umd.js"
        },
        "./event-matches/umd": "./dist/event-matches.umd.min.js",
        "./event-advancement": {
            "types": "./src/event-advancement/event-advancement.d.ts",
            "import": "./src/event-advancement/event-advancement.mjs",
            "require": "./dist/event-advancement.umd.js"
        },
        "./event-advancement/umd": "./dist/event-advancement.umd.min.js",
        "./league-standings": {
            "types": "./src/league-standings/league-standings.d.ts",
            "import": "./src/league-standings/league-standings.mjs",
            "require": "./dist/league-standings.umd.js"
        },
        "./league-standings/umd": "./dist/league-standings.umd.min.js",
        "./countdown": {
            "types": "./src/countdown/countdown.d.ts",
            "import": "./src/countdown/countdown.mjs",
            "require": "./dist/countdown.umd.js"
        },
        "./countdown/umd": "./dist/countdown.umd.min.js",
        "./package.json": "./package.json"
    },
    "typesVersions": {
        "*": {
            "pit-map": [
                "./src/pit-map/pit-map.d.ts"
            ],
            "team-card": [
                "./src/team-card/team-card.d.ts"
            ],
            "team-results": [
                "./src/team-results/team-results.d.ts"
            ],
            "team-awards": [
                "./src/team-awards/team-awards.d.ts"
            ],
            "next-match": [
                "./src/next-match/next-match.d.ts"
            ],
            "team-season": [
                "./src/team-season/team-season.d.ts"
            ],
            "event-rankings": [
                "./src/event-rankings/event-rankings.d.ts"
            ],
            "event-matches": [
                "./src/event-matches/event-matches.d.ts"
            ],
            "event-advancement": [
                "./src/event-advancement/event-advancement.d.ts"
            ],
            "league-standings": [
                "./src/league-standings/league-standings.d.ts"
            ],
            "countdown": [
                "./src/countdown/countdown.d.ts"
            ]
        }
    },
    "unpkg": "./dist/pit-map.umd.min.js",
    "jsdelivr": "./dist/pit-map.umd.min.js",
    "files": [
        "src",
        "dist/*.mjs",
        "dist/*.js",
        "docs",
        "README.md",
        "LICENSE"
    ],
    "sideEffects": [
        "./src/pit-map/pit-map.mjs",
        "./src/team-card/team-card.mjs",
        "./src/team-results/team-results.mjs",
        "./src/team-awards/team-awards.mjs",
        "./src/next-match/next-match.mjs",
        "./src/team-season/team-season.mjs",
        "./src/event-rankings/event-rankings.mjs",
        "./src/event-matches/event-matches.mjs",
        "./src/event-advancement/event-advancement.mjs",
        "./src/league-standings/league-standings.mjs",
        "./src/countdown/countdown.mjs",
        "./dist/*.js",
        "./dist/*.mjs"
    ],
    "publishConfig": {
        "access": "public",
        "provenance": true
    },
    "scripts": {
        "build": "node scripts/build.mjs",
        "dev": "node scripts/dev.mjs",
        "test": "node --test scripts/test.mjs",
        "typecheck": "npx -y -p typescript@5.4.5 tsc --noEmit --strict --lib es2020,dom src/pit-map/pit-map.d.ts src/team-card/team-card.d.ts src/team-results/team-results.d.ts src/team-awards/team-awards.d.ts src/next-match/next-match.d.ts src/team-season/team-season.d.ts src/event-rankings/event-rankings.d.ts src/event-matches/event-matches.d.ts src/event-advancement/event-advancement.d.ts src/league-standings/league-standings.d.ts src/countdown/countdown.d.ts",
        "prepare": "node scripts/build.mjs"
    },
    "devDependencies": {
        "esbuild": "0.25.9"
    },
    "keywords": [
        "ftc",
        "first",
        "first-tech-challenge",
        "pit-map",
        "embed",
        "web-component",
        "team",
        "awards",
        "ftcscout",
        "event",
        "rankings"
    ]
}
