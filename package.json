{
    "name": "ftc-embeds",
    "version": "0.3.1",
    "description": "Embeddable FIRST Tech Challenge widgets (pit maps, team cards, season results). Zero dependencies; works with any framework.",
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/mmathijs/ftc-embeds.git"
    },
    "homepage": "https://ftc-embeds.com/",
    "bugs": {
        "url": "https://github.com/mmathijs/ftc-embeds/issues"
    },
    "exports": {
        "./pit-map": {
            "types": "./src/pit-map/pit-map.d.ts",
            "import": "./src/pit-map/pit-map.mjs",
            "require": "./dist/pit-map.umd.js"
        },
        "./pit-map/umd": "./dist/pit-map.umd.min.js",
        "./team-card": {
            "types": "./src/team-card/team-card.d.ts",
            "import": "./src/team-card/team-card.mjs",
            "require": "./dist/team-card.umd.js"
        },
        "./team-card/umd": "./dist/team-card.umd.min.js",
        "./team-results": {
            "types": "./src/team-results/team-results.d.ts",
            "import": "./src/team-results/team-results.mjs",
            "require": "./dist/team-results.umd.js"
        },
        "./team-results/umd": "./dist/team-results.umd.min.js",
        "./package.json": "./package.json"
    },
    "typesVersions": {
        "*": {
            "pit-map": [
                "./src/pit-map/pit-map.d.ts"
            ],
            "team-card": [
                "./src/team-card/team-card.d.ts"
            ],
            "team-results": [
                "./src/team-results/team-results.d.ts"
            ]
        }
    },
    "unpkg": "./dist/pit-map.umd.min.js",
    "jsdelivr": "./dist/pit-map.umd.min.js",
    "files": [
        "src",
        "dist/*.mjs",
        "dist/*.js",
        "docs",
        "README.md",
        "LICENSE"
    ],
    "sideEffects": [
        "./src/pit-map/pit-map.mjs",
        "./src/team-card/team-card.mjs",
        "./src/team-results/team-results.mjs",
        "./dist/*.js",
        "./dist/*.mjs"
    ],
    "publishConfig": {
        "access": "public",
        "provenance": true
    },
    "scripts": {
        "build": "node scripts/build.mjs",
        "test": "node --test scripts/test.mjs",
        "typecheck": "npx -y -p typescript@5.4.5 tsc --noEmit --strict --lib es2020,dom src/pit-map/pit-map.d.ts src/team-card/team-card.d.ts src/team-results/team-results.d.ts",
        "prepare": "node scripts/build.mjs"
    },
    "devDependencies": {
        "esbuild": "0.25.9"
    },
    "keywords": [
        "ftc",
        "first",
        "first-tech-challenge",
        "pit-map",
        "embed",
        "web-component",
        "team",
        "awards",
        "ftcscout"
    ]
}
